# Application environment and version
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Cross-origin resource sharing (JSON array of allowed origins)
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Demonstration mode and label configuration
DEMO_MODE=true
ALLOW_SYNTHETIC_LABELS=true

# Database connection URL (PostgreSQL 15+)
DATABASE_URL=postgresql+asyncpg://tracex:tracex_dev_pass@localhost:5432/tracex

# Chain default and data adapter (mock, etherscan, rpc)
CHAIN_DEFAULT=ethereum
DATA_ADAPTER=mock

# Explorer API configuration (Etherscan or compatible)
EXPLORER_API_BASE_URL=https://api.etherscan.io/api
EXPLORER_API_KEY=
EXPLORER_TIMEOUT_SECONDS=15
EXPLORER_MAX_RETRIES=3
EXPLORER_RATE_LIMIT_PER_SECOND=4

# Cache configuration in seconds
CACHE_TTL_HISTORICAL_SECONDS=3600
CACHE_TTL_RECENT_SECONDS=60

# Graph engine parameters
GRAPH_MAX_HOPS_DEFAULT=4
GRAPH_MAX_HOPS_HARD_LIMIT=6
GRAPH_MAX_NODES_DEFAULT=500
GRAPH_MAX_NODES_HARD_LIMIT=2000
GRAPH_MAX_EDGES_DEFAULT=2000
GRAPH_MAX_EDGES_HARD_LIMIT=8000
GRAPH_TIME_WINDOW_DAYS_DEFAULT=30
GRAPH_TIME_WINDOW_DAYS_HARD_LIMIT=180
GRAPH_HIGH_DEGREE_THRESHOLD=200
GRAPH_MIN_TRANSFER_VALUE_USD_EQUIVALENT=0
GRAPH_VALUE_TRACING_METHOD=proportional

# Attribution parameters
LABEL_STALE_AFTER_DAYS=365

# Corroboration parameters
CORROBORATION_MIN_SHARED_PATH_LENGTH=2
CORROBORATION_MAX_TIME_SKEW_DAYS=45
CORROBORATION_HUB_EXCLUSION_DEGREE=100

# Rate limits and request boundaries
RATE_LIMIT_CASES_PER_MINUTE_PER_IP=10
REQUEST_MAX_BODY_BYTES=16384

# Data retention in days
REPORT_RETENTION_DAYS=90
CASE_RETENTION_DAYS=180

# Security and auth tokens (server only)
APP_SECRET_KEY=dev_secret_key_change_in_production_min32chars!
INVESTIGATOR_TOKEN=dev_investigator_token_12345
ADMIN_TOKEN=dev_admin_token_67890
